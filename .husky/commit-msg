#!/bin/sh
commit_msg=$(head -1 "$1")
pattern='^(feat|fix|perf|deps|docs|chore|ci|test|refactor)(\(.+\))?(!)?: .+'
if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "ERROR: Commit message must follow Conventional Commits format"
  echo "  <type>[optional scope]: <description>"
  echo ""
  echo "  Types: feat, fix, perf, deps, docs, chore, ci, test, refactor"
  echo "  Examples:"
  echo "    feat: add new command"
  echo "    fix(cli): handle empty input"
  echo "    feat!: redesign API"
  exit 1
fi
