{
  "name": "ts-suppress",
  "version": "2.0.0",
  "description": "Incremental TypeScript strictness adoption via bulk error suppression",
  "keywords": [
    "migration",
    "strict",
    "suppression",
    "tanstack-intent",
    "ts-ignore",
    "typescript"
  ],
  "homepage": "https://github.com/br0p0p/ts-suppress#readme",
  "bugs": {
    "url": "https://github.com/br0p0p/ts-suppress/issues"
  },
  "license": "MIT",
  "author": "br0p0p",
  "repository": {
    "type": "git",
    "url": "https://github.com/br0p0p/ts-suppress.git"
  },
  "bin": {
    "ts-suppress": "dist/cli.js"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.7.0",
    "husky": "^9.1.7",
    "knip": "^5.87.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.32.1"
}
